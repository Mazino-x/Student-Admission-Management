meta {
  name: Create Student
  type: http
  seq: 1
}

post {
  url: http://127.0.0.1:8000/students
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Kunal",
    "email": "kunal@example.com",
    "phone": "9876543210",
    "course": "B.tech",
    "year": 4
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.name: eq Kunal
  res.body.email: eq kunal@example.com
}
